---
import { z } from "astro:content";

const schema = z.object({
	subtitle: z.string().optional(),
	endDate: z.string().optional(),
	startDate: z.string(),
	details: z.string(),
	title: z.string(),
});

type Props = z.input<typeof schema>;
const props = schema.parse(Astro.props);
---

<article class="mt-3 flex flex-col">
	<div class="flex flex-row items-center justify-between uppercase">
		<h3 class="text-lg font-bold tracking-wider uppercase">
			{props.title}
			{
				!!props.subtitle && (
					<>
						<span class="font-light">~</span>
						<span class="font-normal tracking-normal">
							{props.subtitle}
						</span>
					</>
				)
			}
			<span class="font-light">~</span>
			<span class="font-normal tracking-wider">{props.details}</span>
		</h3>
		<span class="font-bold uppercase tracking-wide">
			{
				!!props.endDate
					? `${props.startDate} ~ ${props.endDate}`
					: `Since ${props.startDate}`
			}
		</span>
	</div>
	<div class="-mt-0.5 tracking-wide leading-tight font-normal">
		<slot />
	</div>
</article>
